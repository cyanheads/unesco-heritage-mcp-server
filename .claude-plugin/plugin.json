{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "unesco-heritage-mcp-server",
  "version": "0.1.1",
  "description": "Search UNESCO World Heritage sites, intangible heritage, biosphere reserves, and Global Geoparks.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/unesco-heritage-mcp-server#readme",
  "repository": "https://github.com/cyanheads/unesco-heritage-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "unesco",
    "world-heritage",
    "intangible-cultural-heritage",
    "biosphere-reserves",
    "geoparks"
  ],
  "mcpServers": {
    "unesco-heritage-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/unesco-heritage-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
